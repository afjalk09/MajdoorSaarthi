# Backend origin used for Socket.IO (leave unset in local dev)
VITE_SOCKET_URL=http://localhost:5000

# Backend origin for all REST calls, including the auth-gated document stream.
# In production set this to the Render backend URL, e.g.
#   VITE_ASSET_URL=https://your-backend.onrender.com
# Leave unset locally - the Vite dev proxy forwards /api to localhost:5000.
VITE_ASSET_URL=
