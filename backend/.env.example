# Database
DATABASE_URL=postgresql://user:password@host:5432/majdoorsaarthi

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Payments: platform commission as a 0-1 fraction (0.05 = 5%)
PLATFORM_COMMISSION_RATE=0.05

# Object storage (Neon Object Storage, S3-compatible).
# In production all four credentials + bucket are required; leave them unset
# locally to fall back to the backend/uploads directory on disk.
AWS_REGION=us-east-2
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=majdoorsaarthi-docs
